<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Launch window theme only: everything after the first frame is Material 3 in Compose.
      The window background follows the system's light/dark setting so a cold start does not
      flash white on a dark device.
    -->
    <style name="Theme.DourDiary" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
